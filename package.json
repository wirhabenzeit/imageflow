{
  "name": "imageflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.20.0 || ^24.12.0 || >=25.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "npm run build && node scripts/stage-desktop.mjs && electron .build/desktop",
    "build": "tsc --noEmit && tsc -p sample/starter/template && vite build",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "test:unit": "node scripts/test-unit.mjs",
    "test:desktop": "npm run build && node scripts/test-unit.mjs && node scripts/stage-desktop.mjs && node scripts/smoke-desktop.mjs && node scripts/smoke-draft.mjs && node scripts/smoke-edit.mjs && node scripts/smoke-files.mjs && node scripts/smoke-layouts.mjs"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.0.2",
    "pdf-lib": "1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.34.5",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "22.19.11",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "playwright-core": "1.57.0",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
