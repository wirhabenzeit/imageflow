{
  "name": "senja-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build:renderer": "mkdir -p .build && swiftc -module-cache-path .build/module-cache renderer/export.swift -o .build/senja-export",
    "predev": "npm run build:renderer",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/preview.mjs",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "prepreview": "npm run build:renderer",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "22.19.11",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "electron": "45.2.3",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  }
}
