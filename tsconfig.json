{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "DOM.AsyncIterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src", "desktop", "tests", "vite.config.ts"],
  // Template-side type checks with the starter's own settings: `tsc -p tests/types`. Compatibility books carry their own
  // template copies, checked as books (tests/compat-books.test.ts), not as app source; the field-notes fixture book is a
  // template too, loaded by the tests that copy it.
  "exclude": ["tests/types", "tests/compat/books", "tests/fixtures/field-notes"]
}
